{
	"name": "cloudflare-caricature-booth",
	"version": "0.0.0",
	"private": true,
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "concurrently -n css,wrangler -c yellow,blue \"npm:dev:css\" \"npm:dev:wrangler\"",
		"dev:css": "tailwindcss -i ./src/styles/app.css -o ./public/app.css --watch",
		"dev:wrangler": "wrangler dev",
		"build": "tailwindcss -i ./src/styles/app.css -o ./public/app.css --minify",
		"build:css": "tailwindcss -i ./src/styles/app.css -o ./public/app.css --minify",
		"start": "wrangler dev",
		"deploy": "npm run build:css && wrangler deploy",
		"cf-typegen": "wrangler types --env-file .dev.vars.example",
		"test": "vitest run",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"hono": "^4.13.2",
		"jose": "^6.2.8",
		"qrcode": "^1.5.4"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.21.2",
		"@tailwindcss/cli": "^4.3.0",
		"@types/qrcode": "^1.5.6",
		"concurrently": "^9.2.4",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.5.2",
		"vitest": "^4.1.10",
		"wrangler": "^4.122.0"
	}
}
